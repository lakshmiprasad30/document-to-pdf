# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# -----------------
# Frontend Configuration
# -----------------
# The public URL where your FastAPI backend is hosted. 
# Used by the Next.js frontend to make API calls.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# -----------------
# Backend (FastAPI) Configuration
# -----------------
# The domain used by Caddy to auto-provision Let's Encrypt SSL certificates.
DOMAIN=api.yourdomain.com

# Comma-separated list of allowed origins for CORS.
# Must include your frontend's production domain to prevent browser blocks.
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Redis connection string. For Docker Compose, the default works out of the box.
REDIS_URL=redis://redis:6379/0

# Storage path for temporary files inside the container. Do not change unless modifying docker-compose volumes.
TEMP_STORAGE_PATH=/tmp/uploads

# Maximum allowed file size for uploads in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Timeout for individual LibreOffice conversion jobs in seconds
CONVERSION_TIMEOUT_SECONDS=300

# Background task cleanup TTL. Files older than this are deleted automatically to save disk space.
CLEANUP_TTL_SECONDS=3600

# Rate Limiting configuration (Calls per Window)
RATE_LIMIT_CALLS=10
RATE_LIMIT_WINDOW=60
